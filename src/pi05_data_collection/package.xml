<?xml version="1.0"?>
<package format="2">
  <name>pi05_data_collection</name>
  <version>0.1.0</version>
  <description>Continuous dual-arm RGB and joint trajectory collection for PI05.</description>
  <maintainer email="maintainer@example.invalid">PI05 maintainers</maintainer>
  <license>MIT</license>
  <buildtool_depend>catkin</buildtool_depend>
  <depend>cv_bridge</depend>
  <depend>data_msgs</depend>
  <depend>piper_msgs</depend>
  <depend>rospy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-tk</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rosbag</exec_depend>
</package>
