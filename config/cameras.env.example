# PI05 相机角色映射的机器本地记录模板。
# 复制为 config/cameras.env 后再填写；该路径已被 .gitignore 忽略。
#
# 取值来源：scripts/check_cameras.sh --discover 列出的 USB 物理端口，
# 再由现场逐条追踪（拔插/看画面）确认哪个端口对应哪一侧。
#
# 隐私约定：本模板只保留空值和说明，禁止把真实序列号写进仓库文件。
# 真实序列号只写入 Git 忽略的 config/cameras.env，且 check_cameras.sh
# 的输出始终只显示脱敏值（形如 ***CW）。
#
# 本机角色（2026-09-17 现场确认）：
#   左腕 = Orbbec Dabai DC1    右腕 = Orbbec Dabai DC1    顶部 = Intel RealSense
# Dabai DC1 由同一台相机的两个 USB 设备组成，必须挂在同一个父 hub 下：
#   彩色半边 = UVC 2bc5:0557（带序列号，内核 uvcvideo）
#   深度半边 = OpenNI 协议 2bc5:0657（无 USB 序列号，需要 Orbbec SDK v1）
# check_cameras.sh 会校验两者同父 hub、VID:PID、序列号与 UVC 绑定状态。

PI05_CAMERA_LEFT_WRIST_MODEL=dabai_dc1
PI05_CAMERA_LEFT_WRIST_RGB_USB_PORT=
PI05_CAMERA_LEFT_WRIST_DEPTH_USB_PORT=
PI05_CAMERA_LEFT_WRIST_SERIAL=

PI05_CAMERA_RIGHT_WRIST_MODEL=dabai_dc1
PI05_CAMERA_RIGHT_WRIST_RGB_USB_PORT=
PI05_CAMERA_RIGHT_WRIST_DEPTH_USB_PORT=
PI05_CAMERA_RIGHT_WRIST_SERIAL=

# 顶部相机：realsense_d455 / realsense_d405 / realsense_d435i。
# D455 与 D405 必须挂在 USB3 端口（速率 5000），否则深度带宽不足；
# 只有临时排查时才把 REQUIRE_USB3 置 false。
PI05_CAMERA_TOP_MODEL=realsense_d455
PI05_CAMERA_TOP_USB_PORT=
PI05_CAMERA_TOP_SERIAL=
PI05_CAMERA_TOP_REQUIRE_USB3=true
