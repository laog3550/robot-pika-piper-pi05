# Copy this file to config/pi05.env and adjust it on the PI05 host.
# Do not commit config/pi05.env.

PI05_ROS_DISTRO=noetic
# Fill these identity fields from scripts/discover_devices.sh. Do not use a
# device serial number or /dev/serial/by-id path.
PI05_CAN_INTERFACE=
PI05_CAN_BITRATE=1000000
PI05_CAN_USB_BUS_INFO=
PI05_PIKA_SERIAL_ALIAS=/dev/pi05-pika-right
PI05_PIKA_SERIAL_BAUD=460800
PI05_PIKA_SERIAL_ID_PATH=
PI05_PIKA_SERIAL_VENDOR_ID=
PI05_PIKA_SERIAL_MODEL_ID=
PI05_ARM_SIDE=right
PI05_AUTO_ENABLE=false
