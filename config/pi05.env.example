# Copy this file to config/pi05.env and adjust it on the PI05 host.
# Do not commit config/pi05.env.

PI05_ROS_DISTRO=noetic
# Fill both sides from scripts/discover_devices.sh. Do not use a device serial
# number or /dev/serial/by-id path. A side may remain empty until its cable has
# been physically traced; configuring the other side remains possible.
PI05_LEFT_CAN_INTERFACE=left_piper
PI05_LEFT_CAN_BITRATE=1000000
PI05_LEFT_CAN_USB_BUS_INFO=
PI05_RIGHT_CAN_INTERFACE=right_piper
PI05_RIGHT_CAN_BITRATE=1000000
PI05_RIGHT_CAN_USB_BUS_INFO=

PI05_LEFT_PIKA_SERIAL_ALIAS=/dev/pi05-pika-left
PI05_LEFT_PIKA_SERIAL_BAUD=460800
PI05_LEFT_PIKA_SERIAL_ID_PATH=
PI05_LEFT_PIKA_SERIAL_VENDOR_ID=
PI05_LEFT_PIKA_SERIAL_MODEL_ID=
PI05_RIGHT_PIKA_SERIAL_ALIAS=/dev/pi05-pika-right
PI05_RIGHT_PIKA_SERIAL_BAUD=460800
PI05_RIGHT_PIKA_SERIAL_ID_PATH=
PI05_RIGHT_PIKA_SERIAL_VENDOR_ID=
PI05_RIGHT_PIKA_SERIAL_MODEL_ID=

PI05_ARM_MODE=dual
PI05_AUTO_ENABLE=false
